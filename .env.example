# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_control_tower
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Alerts / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENT_EMAIL=control_tower_alerts@example.com
ENABLE_EMAIL_ALERTS=false

# Simulation & Forecast Settings
PROPHET_FORECAST_HORIZON_DAYS=7
DELAY_SIMULATION_DAYS=7

# Superset / Airflow Settings
SUPERSET_PORT=8088
AIRFLOW_PORT=8080

